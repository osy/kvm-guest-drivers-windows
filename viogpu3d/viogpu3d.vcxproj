      <WppEnabled>true</WppEnabled>
      <WppScanConfigurationData>trace.h</WppScanConfigurationData>
    </ClCompile>
    <PostBuildEvent />
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="..\common\baseobj.h" />
    <ClInclude Include="..\common\bitops.h" />
    <ClInclude Include="..\common\handle.h" />
    <ClInclude Include="..\common\helper.h" />
    <ClInclude Include="..\common\viogpu_pnp_fixup.h" />
    <ClInclude Include="..\common\viogpu_queue.h" />
    <ClInclude Include="..\common\virgl_hw.h" />
    <ClInclude Include="driver.h" />
    <ClInclude Include="viogpu_command.h" />
    <ClInclude Include="viogpu_device.h" />
    <ClInclude Include="trace.h" />
    <ClInclude Include="viogpu_allocation.h" />
    <ClInclude Include="viogpu_adapter.h" />
    <ClInclude Include="resource.h" />
    <ClInclude Include="viogpu_vidpn.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="..\common\edid.cpp" />
    <ClCompile Include="..\common\viogpu_idr.cpp" />
    <ClCompile Include="..\common\viogpu_pci.cpp" />
    <ClCompile Include="..\common\viogpu_pnp_fixup.cpp" />
    <ClCompile Include="..\common\viogpu_queue.cpp" />
    <ClCompile Include="driver.cpp" />
    <ClCompile Include="viogpu_command.cpp" />
    <ClCompile Include="viogpu_device.cpp" />
    <ClCompile Include="viogpu_allocation.cpp">
      <LanguageStandard>stdcpp20</LanguageStandard>
    </ClCompile>
    <ClCompile Include="viogpu_adapter.cpp" />
    <ClCompile Include="..\common\baseobj.cpp" />
    <ClCompile Include="..\common\bitops.cpp" />
    <ClCompile Include="viogpu_vidpn.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="viogpu3d.rc" />
  </ItemGroup>
  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" />
    <FilesToPackage Include="..\viogpuap\$(OutDir)viogpuap.exe">
      <PackageRelativeDirectory>
      </PackageRelativeDirectory>
    </FilesToPackage>
    <FilesToPackage Include="..\viogpusc\$(OutDir)vgpusrv.exe">
      <PackageRelativeDirectory>
      </PackageRelativeDirectory>
    </FilesToPackage>
  </ItemGroup>
  <ItemGroup>
    <!-- Stamp the INF on every build. Its contents depend on which user-mode
         files are packaged and on the revision stamps, not only on the INX,
         and the substitutions below edit the stamped file in place. -->
    <Inf Include="viogpu3d.inx">
      <MinimalRebuildFromTracking>false</MinimalRebuildFromTracking>
    </Inf>
  </ItemGroup>
  <!-- User-mode driver files.

       VIOGPU_UMD_DIR (an environment variable or an MSBuild property) names a
       flat directory that holds the user-mode half of the package under its
       final file names. The three base files are required. Each optional set
       is packaged when it is present, and the INF gains the matching lines:

         neptune_umd.dll, vulkan_virtio.dll, virtio_icd.json   required
         neptune_umd_arm64.dll + neptune_umd_ec.dll            ARM64X Direct3D views
         vulkan_virtio_arm64.dll + vulkan_virtio_ec.dll        ARM64X Vulkan views
         neptune_umd_x86.dll                                   WOW64 Direct3D driver

       Without VIOGPU_UMD_DIR the driver still compiles and links, which is
       enough for working on it in Visual Studio, but no package is assembled. -->
  <PropertyGroup>
    <UmdDir>$(VIOGPU_UMD_DIR)</UmdDir>
    <UmdDir Condition="'$(UmdDir)'!='' AND !HasTrailingSlash('$(UmdDir)')">$(UmdDir)\</UmdDir>
    <UseUmd Condition="'$(UmdDir)'!=''">true</UseUmd>
    <UseNeptuneArm64x Condition="'$(UseUmd)'=='true' AND Exists('$(UmdDir)neptune_umd_ec.dll')">true</UseNeptuneArm64x>
    <UseVulkanArm64x Condition="'$(UseUmd)'=='true' AND Exists('$(UmdDir)vulkan_virtio_ec.dll')">true</UseVulkanArm64x>
    <UseNeptuneWow Condition="'$(UseUmd)'=='true' AND Exists('$(UmdDir)neptune_umd_x86.dll')">true</UseNeptuneWow>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseUmd)'!='true'">
    <Feature_PackOne>false</Feature_PackOne>
    <EnableInf2cat>false</EnableInf2cat>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseUmd)'=='true'">
    <UmdFile Include="$(UmdDir)neptune_umd.dll;$(UmdDir)vulkan_virtio.dll;$(UmdDir)virtio_icd.json" />
    <UmdFile Condition="'$(UseNeptuneArm64x)'=='true'" Include="$(UmdDir)neptune_umd_arm64.dll;$(UmdDir)neptune_umd_ec.dll" />
    <UmdFile Condition="'$(UseVulkanArm64x)'=='true'" Include="$(UmdDir)vulkan_virtio_arm64.dll;$(UmdDir)vulkan_virtio_ec.dll" />
    <UmdFile Condition="'$(UseNeptuneWow)'=='true'" Include="$(UmdDir)neptune_umd_x86.dll" />
    <FilesToPackage Include="@(UmdFile)">
      <PackageRelativeDirectory>
      </PackageRelativeDirectory>
    </FilesToPackage>
    <PackOne_Files Include="..\viogpuap\$(OutDir)viogpuap.exe" />
    <PackOne_Files Include="..\viogpuap\$(OutDir)viogpuap.pdb" />
    <PackOne_Files Include="..\viogpusc\$(OutDir)vgpusrv.exe" />
    <PackOne_Files Include="..\viogpusc\$(OutDir)vgpusrv.pdb" />
    <PackOne_Files Include="@(UmdFile)" />
  </ItemGroup>
  <!-- INF lines for the optional user-mode files. A substitution without a
       value removes its placeholder. -->
  <ItemGroup>
    <Substitution Include="INX_ARM64X_NATIVE_SRCDISK">
      <ReplaceWith Condition="'$(UseNeptuneArm64x)'=='true'">neptune_umd_arm64.dll = 1,,</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_ARM64X_EC_SRCDISK">
      <ReplaceWith Condition="'$(UseNeptuneArm64x)'=='true'">neptune_umd_ec.dll = 1,,</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_ARM64X_NATIVE_COPY">
      <ReplaceWith Condition="'$(UseNeptuneArm64x)'=='true'">neptune_umd_arm64.dll,,,0</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_ARM64X_EC_COPY">
      <ReplaceWith Condition="'$(UseNeptuneArm64x)'=='true'">neptune_umd_ec.dll,,,0</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_VK_ARM64X_NATIVE_SRCDISK">
      <ReplaceWith Condition="'$(UseVulkanArm64x)'=='true'">vulkan_virtio_arm64.dll = 1,,</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_VK_ARM64X_EC_SRCDISK">
      <ReplaceWith Condition="'$(UseVulkanArm64x)'=='true'">vulkan_virtio_ec.dll = 1,,</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_VK_ARM64X_NATIVE_COPY">
      <ReplaceWith Condition="'$(UseVulkanArm64x)'=='true'">vulkan_virtio_arm64.dll,,,0</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_VK_ARM64X_EC_COPY">
      <ReplaceWith Condition="'$(UseVulkanArm64x)'=='true'">vulkan_virtio_ec.dll,,,0</ReplaceWith>
    </Substitution>
    <!-- The 32-bit driver has its own name because it shares the DriverStore
         directory with the 64-bit one: dirid 13 has no WoW64 redirection and
         forbids renaming in CopyFiles. -->
    <Substitution Include="INX_WOW_SRCDISK">
      <ReplaceWith Condition="'$(UseNeptuneWow)'=='true'">neptune_umd_x86.dll = 1,,</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_WOW_COPY">
      <ReplaceWith Condition="'$(UseNeptuneWow)'=='true'">neptune_umd_x86.dll,,,0</ReplaceWith>
    </Substitution>
    <!-- %25 is an escaped '%': MSBuild would otherwise read %13 as a hex
         character escape and eat the dirid. -->
    <Substitution Include="INX_WOW_UMDNAME">
      <ReplaceWith Condition="'$(UseNeptuneWow)'=='true'">HKR,, UserModeDriverNameWow,       %25REG_MULTI_SZ%25, &quot;&lt;&gt;&quot;,%2513%25\neptune_umd_x86.dll,%2513%25\neptune_umd_x86.dll,%2513%25\neptune_umd_x86.dll</ReplaceWith>
    </Substitution>
  </ItemGroup>
  <Target Name="CheckUmdDir" BeforeTargets="PrepareForBuild">
    <Warning Condition="'$(UseUmd)'!='true'" Text="VIOGPU_UMD_DIR is not set: building viogpu3d.sys without assembling a driver package. See README.md." />
    <Error Condition="'$(UseUmd)'=='true' AND !Exists('%(UmdFile.FullPath)')" Text="VIOGPU_UMD_DIR: %(UmdFile.Identity) is missing." />
    <Error Condition="'$(UseUmd)'=='true' AND Exists('$(UmdDir)neptune_umd_arm64.dll') AND '$(UseNeptuneArm64x)'!='true'" Text="VIOGPU_UMD_DIR: neptune_umd_arm64.dll is present without neptune_umd_ec.dll." />
    <Error Condition="'$(UseUmd)'=='true' AND Exists('$(UmdDir)vulkan_virtio_arm64.dll') AND '$(UseVulkanArm64x)'!='true'" Text="VIOGPU_UMD_DIR: vulkan_virtio_arm64.dll is present without vulkan_virtio_ec.dll." />
    <Error Condition="('$(UseNeptuneArm64x)'=='true' OR '$(UseVulkanArm64x)'=='true') AND '$(Platform)'!='ARM64'" Text="VIOGPU_UMD_DIR holds ARM64X user-mode files, which only an ARM64 driver can package." />
    <Error Condition="'$(UseNeptuneWow)'=='true' AND '$(Platform)'=='Win32'" Text="VIOGPU_UMD_DIR holds neptune_umd_x86.dll, the WOW64 driver of a 64-bit package; a 32-bit driver packages it as neptune_umd.dll." />
  </Target>
  <!-- Revision stamps.

       The INF header names the commits the package was built from, and the
       product version string of viogpu3d.sys names the driver's own. Both are
       optional environment variables or MSBuild properties:

         VIOGPU_KMD_REVISION    this repository; read from git when unset
         VIOGPU_UMD_REVISION    the Mesa fork behind VIOGPU_UMD_DIR

       A value is a bare token such as 0123456789, with a trailing + when the
       tree had uncommitted changes. Anything missing is stamped "unknown". -->
  <Target Name="StampRevisions" BeforeTargets="StampInf;ResourceCompile">
    <PropertyGroup>
      <KmdRevision>$(VIOGPU_KMD_REVISION)</KmdRevision>
      <UmdRevision>$(VIOGPU_UMD_REVISION)</UmdRevision>
    </PropertyGroup>
    <Exec Condition="'$(KmdRevision)'==''" Command="git -C &quot;$(MSBuildProjectDirectory)&quot; describe --always --abbrev=10 --dirty=+ --exclude=* 2&gt;nul" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="KmdRevision" />
    </Exec>
    <PropertyGroup>
      <KmdRevision Condition="'$(KmdRevision)'==''">unknown</KmdRevision>
      <UmdRevision Condition="'$(UmdRevision)'==''">unknown</UmdRevision>
    </PropertyGroup>
    <Message Text="Revisions: viogpu-wddm $(KmdRevision), mesa $(UmdRevision)" Importance="High" />
    <ItemGroup>
      <Substitution Include="INX_REVISION_KMD">
        <ReplaceWith>$(KmdRevision)</ReplaceWith>
      </Substitution>
      <Substitution Include="INX_REVISION_UMD">
        <ReplaceWith>$(UmdRevision)</ReplaceWith>
      </Substitution>
    </ItemGroup>
    <ItemGroup Condition="'$(KmdRevision)'!='unknown'">
      <ResourceCompile>
        <PreprocessorDefinitions>VIOGPU_REVISION=git-$(KmdRevision);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      </ResourceCompile>
    </ItemGroup>
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(MSBuildProjectDirectory)\..\build\Driver.Common.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
