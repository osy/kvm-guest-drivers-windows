  <ItemGroup Condition="'$(UseNeptuneArm64x)'=='true'">
    <Substitution Include="INX_ARM64X_NATIVE_SRCDISK">
      <ReplaceWith>neptune_umd_arm64.dll = 1,,</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_ARM64X_EC_SRCDISK">
      <ReplaceWith>neptune_umd_ec.dll = 1,,</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_ARM64X_NATIVE_COPY">
      <ReplaceWith>neptune_umd_arm64.dll,,,0</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_ARM64X_EC_COPY">
      <ReplaceWith>neptune_umd_ec.dll,,,0</ReplaceWith>
    </Substitution>
  </ItemGroup>
  <ItemGroup Condition="'$(UseNeptuneWow)'=='true'">
    <Substitution Include="INX_WOW_SRCDISK">
      <ReplaceWith>neptune_umd_x86.dll = 1,,</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_WOW_COPY">
      <ReplaceWith>neptune_umd_x86.dll,,,0</ReplaceWith>
    </Substitution>
    <!-- %25 is an escaped '%': MSBuild would otherwise read %13 as a hex
         character escape and eat the dirid. -->
    <Substitution Include="INX_WOW_UMDNAME">
      <ReplaceWith>HKR,, UserModeDriverNameWow,       %25REG_MULTI_SZ%25, &quot;&lt;&gt;&quot;,%2513%25\neptune_umd_x86.dll,%2513%25\neptune_umd_x86.dll,%2513%25\neptune_umd_x86.dll</ReplaceWith>
    </Substitution>
  </ItemGroup>
